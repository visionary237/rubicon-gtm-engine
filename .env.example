# RUBICON never reads API keys from the repository. Keys live in your MCP
# configuration (claude mcp add ...) or in your shell environment.
# Names below are documentation only; leave values empty in any committed file.
RUBICON_MODE=mock            # mock | dry-run | live
ICYPEAS_API_KEY=
PIPECORN_API_KEY=
ALLO_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
PERPLEXITY_API_KEY=
